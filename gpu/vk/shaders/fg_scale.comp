#version 450
// the frame to the window's size (the Insert menu's Upscaling, Sharpness): Catmull-Rom or Lanczos 2, or the linear filter (each
// stretched over the picture's pixels one window pixel covers when the picture is the larger), then
// a contrast-adaptive sharpen in the manner of AMD FidelityFX RCAS that cannot go past the light around the pixel, so it adds no halos,
// no clipping and no flashes
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
// (FG_SCALE_PQ, compiled into fg_scale_pq_comp_spv.h: the game's own HDR10 picture (Native HDR, PQ codes) into RGB10A2, which
// keeps the codes' 10 bits; vk_framegen.cpp framegen_scale's pq)
#ifdef FG_SCALE_PQ
layout(binding = 1, rgb10_a2) uniform writeonly image2D dst;
const float kSteps = 1023.0;   // (the destination's steps: the dither below)
#else
layout(binding = 1, rgba8) uniform writeonly image2D dst;
const float kSteps = 255.0;
#endif
// (and ultrawide's menus: while a menu shows, the picture's sides outside the middle 16:9, x0..x1 of its width, out of focus
// (side 1) or black (side 2), with a short soft edge; vk_framegen.cpp wide_sides. Side 3: this dispatch makes the picture at
// 1/8 for side 1's blur instead, into dst; side 1 then reads it as small. With the Retro look side 3 makes its 240 lines instead)
layout(binding = 2) uniform sampler2D small;
// (and the FXAA, Bloom and Colour grade rows, last on the picture before the sides: vk_framegen.cpp framegen_scale. From Ocarina
// Reborn. Look 0 is the picture untouched; the grade's saturation and contrast are around mid grey, warm (+) or cool (-) its
// white balance, and the vignette a soft darkening of the corners. Bloom 0 is none, 1 the glow at its strongest. And the Retro
// look row, retro: 0 Off, 1 N64, 2 N64 + CRT, in the filter's place: retro() and crt() below, N64 + CRT's rows with it)
layout(push_constant) uniform P { int mode; float sharp; float x0; float x1; int side; float cover;
                                  float sat; float contrast; float warm; float vignette; int look; float bloom; int fxaa;
                                  int retro; float scan; int mask; float mask_str; float glow; float warp_x; float warp_y;
                                  float corner; float gamma; int cvd; } pc;
// (and the loading cover between two areas, which the game draws in that middle too: pc.cover, 0 open to 1 closed, closes the
// sides by as much. The game blends its cover over the picture's light, before the picture is coded for the screen (measured:
// under a half-open cover a pixel's light is the same fraction of its light without it at every brightness, its code is
// not), so the sides' light is scaled the same way: the code to light, times 1 - cover, back to the code)
#ifdef FG_SCALE_PQ
// (SMPTE ST 2084, light as a fraction of its 10,000 nits)
float to_light(float c) {
    const float p = pow(max(c, 0.0), 1.0 / 78.84375);
    return pow(max(p - 0.8359375, 0.0) / (18.8515625 - 18.6875 * p), 1.0 / 0.1593017578125);
}
float to_code(float l) {
    const float y = pow(max(l, 0.0), 0.1593017578125);
    return pow((0.8359375 + 18.8515625 * y) / (1.0 + 18.6875 * y), 78.84375);
}
#else
// (sRGB)
float to_light(float c) { return c <= 0.04045 ? c / 12.92 : pow((c + 0.055) / 1.055, 2.4); }
float to_code(float l) { return l <= 0.0031308 ? l * 12.92 : 1.055 * pow(l, 1.0 / 2.4) - 0.055; }
#endif
vec3 dimmed(vec3 c, float k) { return vec3(to_code(to_light(c.r) * k), to_code(to_light(c.g) * k), to_code(to_light(c.b) * k)); }
// (a pixel of the picture outside the middle is darkened as it is read, before the filter and the sharpen, so the seam stays
// where the game's cover ends at any window size and no side pixel's light is filtered into the middle)
vec3 pixel(ivec2 t, ivec2 size) {
    t = clamp(t, ivec2(0), size - 1);
    const vec3 c = texelFetch(src, t, 0).rgb;
    const float u = (float(t.x) + 0.5) / float(size.x);
    return pc.cover > 0.0 && (u < pc.x0 || u > pc.x1) ? dimmed(c, 1.0 - pc.cover) : c;
}
// the picture at uv through the linear filter: the sampler's, or while the cover shows the same four pixels, each darkened first
vec3 bilinear(vec2 uv) {
    if (pc.cover <= 0.0) return textureLod(src, uv, 0.0).rgb;
    const ivec2 size = textureSize(src, 0);
    const vec2 p = uv * vec2(size) - 0.5;
    const ivec2 b = ivec2(floor(p));
    const vec2 f = p - vec2(b);
    return mix(mix(pixel(b, size), pixel(b + ivec2(1, 0), size), f.x), mix(pixel(b + ivec2(0, 1), size), pixel(b + ivec2(1, 1), size), f.x), f.y);
}
const float PI = 3.14159265;
float lanczos2(float x) {
    x = abs(x);
    if (x < 1e-4) return 1.0;
    if (x >= 2.0) return 0.0;
    const float p = PI * x;
    return 2.0 * sin(p) * sin(p * 0.5) / (p * p);
}
float catmull(float x) {
    x = abs(x);
    if (x < 1.0) return 1.5 * x * x * x - 2.5 * x * x + 1.0;
    if (x < 2.0) return -0.5 * x * x * x + 2.5 * x * x - 4.0 * x + 2.0;
    return 0.0;
}
float tent(float x) { return max(1.0 - abs(x), 0.0); }
// The filter's weight at d picture pixels, and how far it reaches (in picture pixels at stretch 1)
float kernel(float d) { return pc.mode == 2 ? lanczos2(d) : pc.mode == 1 ? catmull(d) : tent(d); }
float reach() { return pc.mode == 0 ? 1.0 : 2.0; }
// Shrinking, the filter is stretched by the picture's pixels per window pixel: at the picture's own spacing its taps skip
// most of the picture (4 x 4 of the 6 x 6 one window pixel's Lanczos needs at 3840 x 2160 to 2560 x 1440), and fine detail
// came out as shimmer and moire, worse than the plain linear copy. shortcut: up to 4 (16 x 16 taps); a smaller window aliases
// again past that, a mip chain first if anyone plays a 5K picture in a quarter-size window
const float kMaxStretch = 4.0;
vec3 filtered(vec2 uv) {
    const vec2 size = vec2(textureSize(src, 0));
    const vec2 s = clamp(size / vec2(imageSize(dst)), vec2(1.0), vec2(kMaxStretch));
    if (pc.mode == 0 && s == vec2(1.0)) return bilinear(uv);
    const vec2 p = uv * size - 0.5;
    // (at stretch 1: the 4 x 4 around p for Catmull-Rom and Lanczos, as before)
    const ivec2 lo = ivec2(floor(p - reach() * s)) + 1, hi = ivec2(floor(p + reach() * s));
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    for (int y = lo.y; y <= hi.y; y++) {
        const float wy = kernel((float(y) - p.y) / s.y);
        for (int x = lo.x; x <= hi.x; x++) {
            const float w = kernel((float(x) - p.x) / s.x) * wy;
            sum += w * pixel(ivec2(x, y), ivec2(size));
            weight += w;
        }
    }
    return sum / weight;
}
// The Sharpness slider (pc.sharp 0 to 1) is RCAS's strength: 0 the picture as filtered, 1 its strongest lobe.
const float kMaxLobe = 0.25 - 1.0 / 16.0;
vec3 sharpen(vec3 c, vec3 n, vec3 s, vec3 w, vec3 e, float amount) {
    // RCAS: the four neighbours weighted by a negative lobe, the largest that keeps the result inside 0..1 for this
    // neighbourhood (smaller where the light is near black or white), then normalized. Two differences from RCAS's own
    // maths: the room to black divides by 4 x the lightest of the pixel and its neighbours (RCAS: of the neighbours
    // alone), never more room than RCAS gives, so only more careful; and like RCAS the room is the smallest of the three
    // channels, so a saturated colour (a channel near 0 or 1, not only near black or white) is sharpened little
    const vec3 lo4 = min(min(n, s), min(w, e)), hi4 = max(max(n, s), max(w, e));
    const vec3 lo = min(lo4, c), hi = max(hi4, c);
    const vec3 to_black = lo / max(4.0 * hi, vec3(1.0 / 1024.0));
    const vec3 to_white = (1.0 - hi) / max(4.0 - 4.0 * lo4, vec3(1.0 / 1024.0));
    const vec3 room = min(to_black, to_white);
    const float lobe = -clamp(min(min(room.r, room.g), room.b), 0.0, kMaxLobe) * clamp(amount, 0.0, 1.0);
    const vec3 sharp = (c + lobe * (n + s + w + e)) / (1.0 + 4.0 * lobe);
    // (and no further than the lightest and darkest pixel around it: an edge gets steeper, no halo beside it)
    return clamp(sharp, lo, hi);
}
// beside a menu: what the game draws there (a menu's neighbouring pages, the frame of play) out of focus, a little dimmed, so the
// middle stands out. From the picture at 1/8 (side 3's dispatch, each of its pixels the mean of an 8 x 8 block): a Gaussian of 9 x 9
// taps 2 of its pixels apart (sigma 4 of them, about 2% of the height)
vec3 side_fill(vec2 uv) {
    const vec2 step = 2.0 / vec2(textureSize(small, 0));
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    for (int y = -4; y <= 4; y++)
        for (int i = -4; i <= 4; i++) {
            const float w = exp(-float(i * i + y * y) / 8.0);   // (sigma 2 taps)
            sum += w * textureLod(small, clamp(uv + vec2(i, y) * step, vec2(0.0), vec2(1.0)), 0.0).rgb;
            weight += w;
        }
    const vec3 fill = sum / weight * 0.75;
    return pc.cover > 0.0 ? dimmed(fill, 1.0 - pc.cover) : fill;   // (under the loading cover, as pixel())
}
// the Colour grade row
vec3 grade(vec3 c, vec2 uv) {
    const float luma = dot(c, vec3(0.2126, 0.7152, 0.0722));
    c = mix(vec3(luma), c, pc.sat);
    c = (c - 0.5) * pc.contrast + 0.5;
    c *= vec3(1.0 + pc.warm, 1.0 + pc.warm * 0.25, 1.0 - pc.warm);
    const float r = length((uv - 0.5) * vec2(1.0, 0.75)) * 1.6;   // (0 in the middle, about 1 in the corners)
    c *= 1.0 - pc.vignette * smoothstep(0.45, 1.0, r);
    return clamp(c, 0.0, 1.0);
}
// the Bloom row: the light above a threshold, from the picture at 1/8 (side 3's dispatch, as the sides' blur), blurred wide
// and added back over the picture
vec3 bloom_glow(vec2 uv) {
    const vec2 step = 1.5 / vec2(textureSize(small, 0));
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    for (int y = -3; y <= 3; y++)
        for (int i = -3; i <= 3; i++) {
            const float w = exp(-float(i * i + y * y) / 6.0);
            const vec3 t = textureLod(small, clamp(uv + vec2(i, y) * step, vec2(0.0), vec2(1.0)), 0.0).rgb;
            const float l = dot(t, vec3(0.2126, 0.7152, 0.0722));
            sum += w * t * smoothstep(0.62, 0.95, l);   // (only what is bright glows)
            weight += w;
        }
    return sum / weight;
}
// the FXAA row: edges smoothed on the picture as it is scaled, in the manner of FXAA 3.11's quality preset 10 (a contrast test
// on the 3 x 3 luma, then a blend across the edge, its end found by a short search along it). Linear taps: it scales too
float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
vec3 fxaa(vec2 uv) {
    const vec2 px = 1.0 / vec2(textureSize(src, 0));
    const vec3 rgbM = textureLod(src, uv, 0.0).rgb;
    const float m = lum(rgbM);
    const float n = lum(textureLod(src, uv + vec2(0.0, -px.y), 0.0).rgb), s = lum(textureLod(src, uv + vec2(0.0, px.y), 0.0).rgb);
    const float w = lum(textureLod(src, uv + vec2(-px.x, 0.0), 0.0).rgb), e = lum(textureLod(src, uv + vec2(px.x, 0.0), 0.0).rgb);
    const float lo = min(m, min(min(n, s), min(w, e))), hi = max(m, max(max(n, s), max(w, e)));
    const float range = hi - lo;
    if (range < max(0.0312, hi * 0.125)) return rgbM;   // (no edge here: the pixel untouched)
    const float nw = lum(textureLod(src, uv - px, 0.0).rgb), se = lum(textureLod(src, uv + px, 0.0).rgb);
    const float ne = lum(textureLod(src, uv + vec2(px.x, -px.y), 0.0).rgb), sw = lum(textureLod(src, uv + vec2(-px.x, px.y), 0.0).rgb);
    const float horiz = abs(nw + ne - 2.0 * n) + 2.0 * abs(w + e - 2.0 * m) + abs(sw + se - 2.0 * s);
    const float vert = abs(nw + sw - 2.0 * w) + 2.0 * abs(n + s - 2.0 * m) + abs(ne + se - 2.0 * e);
    const bool hor = horiz >= vert;
    const float l1 = hor ? n : w, l2 = hor ? s : e;
    const float g1 = abs(l1 - m), g2 = abs(l2 - m);
    float stepLen = hor ? px.y : px.x;
    float lEdge = l2;
    if (g1 >= g2) { stepLen = -stepLen; lEdge = l1; }
    const float grad = 0.25 * max(g1, g2), lAvg = 0.5 * (lEdge + m);
    vec2 base = uv;
    if (hor) base.y += stepLen * 0.5; else base.x += stepLen * 0.5;
    const vec2 dir = hor ? vec2(px.x, 0.0) : vec2(0.0, px.y);
    vec2 a = base - dir, b = base + dir;
    float ea = lum(textureLod(src, a, 0.0).rgb) - lAvg, eb = lum(textureLod(src, b, 0.0).rgb) - lAvg;
    bool da = abs(ea) >= grad, db = abs(eb) >= grad;
    const float steps[6] = float[](1.5, 2.0, 2.0, 2.0, 4.0, 8.0);
    for (int i = 0; i < 6 && !(da && db); i++) {
        if (!da) { a -= dir * steps[i]; ea = lum(textureLod(src, a, 0.0).rgb) - lAvg; da = abs(ea) >= grad; }
        if (!db) { b += dir * steps[i]; eb = lum(textureLod(src, b, 0.0).rgb) - lAvg; db = abs(eb) >= grad; }
    }
    const float distA = hor ? uv.x - a.x : uv.y - a.y, distB = hor ? b.x - uv.x : b.y - uv.y;
    const bool nearA = distA < distB;
    const float dist = min(distA, distB), len = distA + distB;
    const bool mSmaller = m - lAvg < 0.0;
    const bool good = ((nearA ? ea : eb) < 0.0) != mSmaller;
    float offset = good ? 0.5 - dist / len : 0.0;
    // (and the sub-pixel part: lines a pixel thin)
    const float avg = (2.0 * (n + s + w + e) + nw + ne + sw + se) / 12.0;
    const float sub = clamp(abs(avg - m) / range, 0.0, 1.0);
    const float subF = (-2.0 * sub + 3.0) * sub * sub;
    offset = max(offset, subF * subF * 0.75);
    vec2 fuv = uv;
    if (hor) fuv.y += offset * stepLen; else fuv.x += offset * stepLen;
    return textureLod(src, fuv, 0.0).rgb;
}
// the Retro look row: the picture as the Nintendo 64 made it, 240 lines (small: side 3's dispatch makes each of its pixels the
// mean of its block of the picture), each pixel's colour cut to the 5 bits a channel of the console's 16-bit picture with the
// console's own ordered dither. N64 (retro()) draws it at the window's size with the linear filter, its dither showing in smooth
// light such as the sky; N64 + CRT (crt()) shows it on a CRT.
// The dither is the RDP's magic square (angrylion-rdp-plus, rdp/dither.c): a channel goes up a step when the part of a step it
// loses is more than the square's value, in eighths, at that pixel; the square repeats every 4 x 4 pixels, fixed to the screen
const int kMagic[16] = int[](0, 6, 1, 7, 4, 2, 5, 3, 3, 5, 2, 4, 7, 1, 6, 0);
vec3 n64_colour(vec3 c, ivec2 t) {
    const float m = float(kMagic[(t.y & 3) * 4 + (t.x & 3)]);
    return min(floor(clamp(c, 0.0, 1.0) * 31.0 + (7.5 - m) / 8.0), vec3(31.0)) / 31.0;
}
// (a pixel of the small picture, cut to 5 bits: dimmed first under the loading cover outside the middle, as pixel())
vec3 retro_pixel(ivec2 t, ivec2 size) {
    t = clamp(t, ivec2(0), size - 1);
    vec3 c = texelFetch(small, t, 0).rgb;
    if (pc.cover > 0.0) {
        const float u = (float(t.x) + 0.5) / float(size.x);
        if (u < pc.x0 || u > pc.x1) c = dimmed(c, 1.0 - pc.cover);
    }
    return n64_colour(c, t);
}
vec3 retro(vec2 uv) {
    const ivec2 size = textureSize(small, 0);
    const vec2 p = uv * vec2(size) - 0.5;
    const ivec2 b = ivec2(floor(p));
    const vec2 f = p - vec2(b);
    return mix(mix(retro_pixel(b, size), retro_pixel(b + ivec2(1, 0), size), f.x),
               mix(retro_pixel(b + ivec2(0, 1), size), retro_pixel(b + ivec2(1, 1), size), f.x), f.y);
}
// N64 + CRT, after Timothy Lottes' CRT shader (public domain: libretro glsl-shaders crt/shaders/crt-lottes.glsl, "Please take
// and use, change, or whatever"), worked in light, not in the picture's codes. Each of the 240 lines' pixels is a spot softened
// across by his Gaussian (hardPix, kHardPix); each line a beam of light (crt_beam), the three nearest adding up; his small bloom
// as a glow, from 4 linear taps of the small picture; the mask (crt_mask) on the window's own pixels; his curvature (warpX,
// warpY) with darker corners. The rows: pc.scan, mask, mask_str, glow, warp_x, warp_y, corner (vk_framegen.cpp framegen_scale).
// Never on the game's own HDR10 picture (framegen_scale's retro is 0 there)
const float kHardPix = -3.0;
// the picture's code to light as gamma 2.0, and back by its square root (crt_code): crt-pi's "fake gamma", near sRGB's ~2.2 and
// an exact pair, so a flat colour comes back as it went in, for a multiply where the 13 reads a window pixel makes would each
// cost a pow
vec3 crt_lin(vec3 c) { return c * c; }
vec3 crt_code(vec3 l) { return sqrt(clamp(l, 0.0, 1.0)); }
// a line's light at distance d from its middle, in lines: Lottes' Gaussian exp2(scan * d * d), each channel's beam wider as the
// channel is brighter (by up to kWiden: bright parts fill out, dark parts show the lines, as a CRT's beams did), scaled to keep
// the line's light (the beam's integral 1: times sqrt(-scan ln 2 / pi)), so scanlines never darken the picture. scan 0: none,
// the lines' light shared linearly between them
const float kWiden = 0.35;
vec3 crt_beam(vec3 line, float d, float scan) {
    if (scan >= 0.0) return line * max(1.0 - abs(d), 0.0);
    const vec3 s = scan * (1.0 - kWiden * clamp(line, 0.0, 1.0));
    return line * exp2(s * (d * d)) * sqrt(-s * 0.2206356);
}
// the mask, on the window's pixel g: Lottes' masks (1 his aperture grille, red, green and blue stripes; 2 his "very compressed
// TV style" slot mask, the stripes' rows lit in turn, a step apart every 3 columns; 3 his "stretched VGA" shadow mask, 2-pixel
// phosphors a third of a triad along each row). A phosphor is 1 + strength where lit, 1 - strength where not (his maskLight and
// maskDark: strength 0.5), over the mask's mean, 1 - strength / 3, so the picture keeps its light. Type 0: none
vec3 crt_mask(ivec2 g, int type, float strength) {
    if (type == 0) return vec3(1.0);
    const float dark = 1.0 - strength, light = 1.0 + strength;
    const int lit = type == 3 ? (g.x + 3 * g.y + 2) % 6 / 2 : g.x % 3;
    vec3 m = vec3(lit == 0 ? light : dark, lit == 1 ? light : dark, lit == 2 ? light : dark);
    if (type == 2) m *= ((g.y + (g.x % 6 < 3 ? 1 : 0)) & 1) == 0 ? dark : light;
    return m / (1.0 - strength / 3.0);
}
vec3 crt(vec2 uv, ivec2 g, ivec2 d) {
    vec2 w = uv * 2.0 - 1.0;   // (Lottes' Warp: each side bowed by the square of the other axis)
    w *= vec2(1.0 + w.y * w.y * pc.warp_x, 1.0 + w.x * w.x * pc.warp_y);
    const vec2 cuv = w * 0.5 + 0.5;
    const vec2 edge = min(cuv, 1.0 - cuv) * vec2(d);   // (the screen's edge, a window pixel soft)
    const float inside = clamp(min(edge.x, edge.y) + 0.5, 0.0, 1.0);
    if (inside <= 0.0) return vec3(0.0);
    const ivec2 size = textureSize(small, 0);
    const vec2 q = cuv * vec2(size);
    const ivec2 t = ivec2(floor(q));
    const vec2 f = q - vec2(t) - 0.5;   // (from the middle of pixel t, in its pixels)
    const vec3 dx = f.x - vec3(-1.0, 0.0, 1.0);
    const vec3 wx = exp2(kHardPix * dx * dx);
    vec3 c = vec3(0.0);
    for (int j = -1; j <= 1; j++) {
        const vec3 line = (crt_lin(retro_pixel(t + ivec2(-1, j), size)) * wx.x + crt_lin(retro_pixel(t + ivec2(0, j), size)) * wx.y +
                           crt_lin(retro_pixel(t + ivec2(1, j), size)) * wx.z) / (wx.x + wx.y + wx.z);
        c += crt_beam(line, f.y - float(j), pc.scan);
    }
    if (pc.glow > 0.0) {   // (dimmed with the loading cover outside the middle as the pixels are)
        const vec2 o = 0.6 / vec2(size);
        vec3 glow = crt_lin(textureLod(small, cuv - o, 0.0).rgb) + crt_lin(textureLod(small, cuv + vec2(o.x, -o.y), 0.0).rgb) +
                    crt_lin(textureLod(small, cuv + vec2(-o.x, o.y), 0.0).rgb) + crt_lin(textureLod(small, cuv + o, 0.0).rgb);
        if (pc.cover > 0.0 && (cuv.x < pc.x0 || cuv.x > pc.x1)) glow *= 1.0 - pc.cover;
        c += glow * (0.25 * pc.glow);
    }
    c *= crt_mask(g, pc.mask, pc.mask_str);
    const float r = length((uv - 0.5) * vec2(1.0, 0.75)) * 1.6;   // (0 in the middle, about 1 in the corners, as grade())
    return crt_code(c * ((1.0 - pc.corner * smoothstep(0.5, 1.1, r)) * inside));
}
// the Brightness row: each channel's code to the power gamma (100 / the row's percent): below 1 the mid-tones lighter, above 1
// darker, black and white where they were, as a TV's gamma or ReShade's Levels gamma (pow(c, gamma), its "Nvidia reference
// formula" at black 0 and white 1) set it
vec3 brighten(vec3 c, float gamma) { return pow(clamp(c, 0.0, 1.0), vec3(gamma)); }
// the Colour vision row: daltonization, in light. What a viewer with the colour blindness sees is Machado, Oliveira and
// Fernandes' model (A Physiologically-based Model for Simulation of Color Vision Deficiency, IEEE TVCG 15(6), 2009: their Table
// 1's matrices at severity 1.0, for linear RGB, rows here: protanopia, deuteranopia, tritanopia; each row sums to 1, so a grey
// is seen as itself); what they miss, the colour less that, is moved where they can see it by the daltonize error shift (after
// Fidaner, Lin and Ozguven, Analysis of Color Blindness, Stanford 2005: red's part to green and blue, as daltonize.org's and
// ReShade's Daltonize.fx have it, for all three) and added back. A grey misses nothing, so greys and white stay as they are
const float kCvd[27] = float[](0.152286, 1.052583, -0.204868, 0.114503, 0.786281, 0.099216, -0.003882, -0.048116, 1.051998,
                               0.367322, 0.860646, -0.227968, 0.280085, 0.672501, 0.047413, -0.011820, 0.042940, 0.968881,
                               1.255528, -0.076749, -0.178779, -0.078411, 0.930809, 0.147602, 0.004733, 0.691367, 0.303900);
vec3 daltonize(vec3 lin, int type) {
    const int m = (type - 1) * 9;
    const vec3 seen = vec3(dot(vec3(kCvd[m], kCvd[m + 1], kCvd[m + 2]), lin), dot(vec3(kCvd[m + 3], kCvd[m + 4], kCvd[m + 5]), lin),
                           dot(vec3(kCvd[m + 6], kCvd[m + 7], kCvd[m + 8]), lin));
    const vec3 e = lin - seen;
    return clamp(lin + vec3(0.0, 0.7 * e.r + e.g, 0.7 * e.r + e.b), 0.0, 1.0);
}
// last on every pixel the pass writes, the sides too: the rows that set the picture as it is seen (vk_framegen.cpp framegen_scale).
// Never on the game's own HDR10 picture (gamma 1 and cvd 0 there), so to_light and to_code are sRGB's
vec3 finish(vec3 c) {
    if (pc.gamma != 1.0) c = brighten(c, pc.gamma);
    if (pc.cvd != 0) {
        const vec3 l = daltonize(vec3(to_light(c.r), to_light(c.g), to_light(c.b)), pc.cvd);
        c = vec3(to_code(l.r), to_code(l.g), to_code(l.b));
    }
    return c;
}
// (and less than one of the destination's steps of noise over it, kSteps: the dim, smooth sides showed 8-bit steps as contour lines)
float dither(ivec2 g) { return (fract(52.9829189 * fract(0.06711056 * float(g.x) + 0.00583715 * float(g.y))) - 0.5) / kSteps; }
void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 d = imageSize(dst);
    if (any(greaterThanEqual(g, d))) return;
    const vec2 uv = (vec2(g) + 0.5) / vec2(d);
    // the picture at 1/8: 4 x 4 bilinear taps on the corners of each pixel's block's 2 x 2s, its exact mean. (The Retro look's
    // 240 lines: the same 16 taps spread over a block of another size, 6 x 6 of a 1440p picture, 9 x 9 of a 4K one, near its mean)
    if (pc.side == 3) {
        const vec2 block = 1.0 / vec2(d);   // (one pixel of dst: 8 x 8 of the picture)
        vec3 sum = vec3(0.0);
        for (int y = 0; y < 4; y++)
            for (int x = 0; x < 4; x++) sum += textureLod(src, uv + (vec2(x, y) - 1.5) * 0.25 * block, 0.0).rgb;
        imageStore(dst, g, vec4(sum / 16.0, 1.0));
        return;
    }
    // (beside a menu: the sides first, and wholly outside the middle nothing else, not the filter's 16 taps to throw away)
    float outside = 0.0;
    if (pc.side != 0 && pc.x1 > pc.x0) {
        const float feather = 0.006;
        outside = max(1.0 - smoothstep(pc.x0 - feather, pc.x0, uv.x), smoothstep(pc.x1, pc.x1 + feather, uv.x));
        if (outside >= 1.0) {
            imageStore(dst, g, vec4(finish(pc.side == 2 ? vec3(0.0) : side_fill(uv) + dither(g)), 1.0));
            return;
        }
    }
    // (FXAA in the window filter's place; not while the loading cover dims the sides, which only the filter's taps do. The Retro
    // look in the place of both, from its own small picture, which it dims under the cover itself; framegen_scale's sharp is 0)
    vec3 c = pc.retro == 2 ? crt(uv, g, d) : pc.retro != 0 ? retro(uv) : pc.fxaa != 0 && pc.cover <= 0.0 ? fxaa(uv) : filtered(uv);
    if (pc.sharp > 0.0) {
        // The neighbours one picture pixel away (one window pixel when the window is the smaller). They were one window
        // pixel away, a fraction of a picture pixel when the window is larger (0.53 for 2048 x 1152 on a 3840 x 2160
        // screen): what the slider did then hung on the window's size, not on the picture.
        const vec2 e = max(1.0 / vec2(textureSize(src, 0)), 1.0 / vec2(d));
        const vec3 n = bilinear(uv + vec2(0.0, -e.y)), s = bilinear(uv + vec2(0.0, e.y));
        const vec3 w = bilinear(uv + vec2(-e.x, 0.0)), r = bilinear(uv + vec2(e.x, 0.0));
        c = sharpen(c, n, s, w, r, pc.sharp);
    }
    if (pc.bloom > 0.0) c = min(c + bloom_glow(uv) * pc.bloom, vec3(1.0));
    if (pc.look != 0) c = grade(c, uv);
    if (outside > 0.0) c = mix(c, pc.side == 2 ? vec3(0.0) : side_fill(uv) + dither(g), outside);
    imageStore(dst, g, vec4(finish(c), 1.0));
}
