<Project Sdk="Microsoft.NET.Sdk">
  <!-- The launcher's logic, with no package and no UI: tests/launcher_core compiles these sources itself -->
  <PropertyGroup>
    <RootNamespace>LongshotLauncher.Core</RootNamespace>
    <AssemblyName>LongshotLauncher.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- (the launcher's words in each language, Tr.cs: Lang/<code>.json, English to translation) -->
    <EmbeddedResource Include="Lang/*.json" LogicalName="Lang.%(Filename).json"/>
  </ItemGroup>
</Project>
