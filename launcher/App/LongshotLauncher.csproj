<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Longshot Launcher's window (Avalonia): Windows and Linux. Its logic is Core/ -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>LongshotLauncher</AssemblyName>
    <RootNamespace>LongshotLauncher</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- (the Windows program's icon: the Longshot logo, Assets/longshot.ico, made from Assets/longshot.png by scripts/make_icon.py) -->
    <ApplicationIcon>Assets/longshot.ico</ApplicationIcon>
    <!-- (the Windows program's details, as Properties > Details and the antivirus programs show them: a program with only its file
         name there looks more like malware) -->
    <Product>Longshot Launcher</Product>
    <AssemblyTitle>Longshot Launcher</AssemblyTitle>
    <Description>Installs, builds, updates and starts Longshot</Description>
    <Company>MagicBeanDev</Company>
    <Copyright>Copyright © the Longshot Launcher contributors. GPL-3.0-or-later</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia"/>
    <PackageReference Include="Avalonia.Desktop"/>
    <PackageReference Include="Avalonia.Themes.Fluent"/>
    <PackageReference Include="Avalonia.Wayland"/>
  </ItemGroup>
  <ItemGroup>
    <!-- (the release's version, which the launcher compares with its channel's newest: -p:LongshotTag=v3.0.0 or nightly-<count>-<commit>,
         set by the release workflow. Unset, a build from a checkout is "dev" and never updates itself. Core/SelfUpdate.cs) -->
    <AssemblyMetadata Include="LongshotTag" Value="$(LongshotTag)" Condition="'$(LongshotTag)' != ''"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/LongshotLauncher.Core.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <!-- (Inter, under its own licence, Assets/Fonts/Inter-LICENSE.txt, and the Longshot logo, and its icon for the Windows window) -->
    <AvaloniaResource Include="Assets/Fonts/Inter-*.ttf"/>
    <AvaloniaResource Include="Assets/longshot.png"/>
    <AvaloniaResource Include="Assets/longshot.ico"/>
  </ItemGroup>
</Project>
