<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:HookshotLauncher.Controls"
             x:Class="HookshotLauncher.Views.HeroBanner">
  <!-- The README header (assets/brand/hero-banner.webp, scripts/make_hero.py) made live: the 3D Hookshot turning on the left, the
       name in Unbounded ExtraBold in the objects' own colours, the blank Hyrule shield on the right, in their black studio with its
       blue glow. Its words are the header's own, not translated: they are the project's lockup -->
  <Border CornerRadius="16" Height="148" ClipToBounds="True" BorderBrush="{StaticResource GlassLine}" BorderThickness="1"
          Background="#06070B">
    <Panel>
      <Border>
        <Border.Background>
          <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="45%" RadiusY="90%">
            <GradientStop Offset="0" Color="#4D1E40AF"/>
            <GradientStop Offset="1" Color="#001E40AF"/>
          </RadialGradientBrush>
        </Border.Background>
      </Border>
      <Grid ColumnDefinitions="190,*,190">
        <Panel>
          <Ellipse Width="150" Height="120" IsHitTestVisible="False">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Offset="0" Color="#593B82F6"/>
                <GradientStop Offset="1" Color="#003B82F6"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <c:Turntable Name="Hookshot" Width="150" Height="150" Margin="0,-4,0,0"/>
        </Panel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
          <TextBlock Classes="wordmark" Text="Hookshot" FontSize="46" HorizontalAlignment="Center" LineHeight="52"/>
          <TextBlock Text="native, no emulator" FontFamily="{StaticResource Display}" FontWeight="ExtraBold" FontSize="14.5"
                     Foreground="#E2E8F0" HorizontalAlignment="Center"/>
          <TextBlock Text="Ocarina of Time on Windows &amp; Linux" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,10,0,0"
                     Foreground="{StaticResource InkSoft}" HorizontalAlignment="Center"/>
        </StackPanel>
        <Panel Grid.Column="2">
          <Ellipse Width="150" Height="120" IsHitTestVisible="False">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Offset="0" Color="#4D3B82F6"/>
                <GradientStop Offset="1" Color="#003B82F6"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Image Source="avares://HookshotLauncher/Assets/shield.png" Width="124" Height="124" RenderOptions.BitmapInterpolationMode="HighQuality"/>
        </Panel>
      </Grid>
    </Panel>
  </Border>
</UserControl>
