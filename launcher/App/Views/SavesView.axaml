<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LongshotLauncher.ViewModels"
             xmlns:core="using:LongshotLauncher.Core"
             xmlns:c="using:LongshotLauncher.Controls"
             x:Class="LongshotLauncher.Views.SavesView"
             x:DataType="vm:SavesViewModel">
  <UserControl.Styles>
    <Style Selector="Button.transfer">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Height" Value="64"/>
    </Style>
    <Style Selector="Expander /template/ ToggleButton">
      <Setter Property="Background" Value="{StaticResource Glass}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassLine}"/>
    </Style>
    <Style Selector="TextBlock.transferTitle">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel>
        <TextBlock Classes="heading" Text="{c:T 'Saves'}"/>
        <TextBlock Classes="sub" Text="{Binding Sub}"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,290" ColumnSpacing="24">
      <Grid RowDefinitions="Auto,*" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="label" Text="{c:T 'YOUR LONGSHOT SAVES'}" Margin="0" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Classes="faint" Text="{Binding SlotCount}" VerticalAlignment="Center"/>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
          <StackPanel Spacing="10">
            <Border Classes="card" Padding="16,8">
              <Panel>
                <StackPanel IsVisible="{Binding NoSlots}" Spacing="6" Margin="0,18">
                  <TextBlock Text="{c:T 'Start where you left off'}" FontWeight="SemiBold"/>
                  <TextBlock Classes="note" Text="{Binding EmptyHint}" TextWrapping="Wrap"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Slots}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SlotViewModel">
                      <Grid ColumnDefinitions="26,*,Auto" ColumnSpacing="10" Height="35">
                        <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource SoftNum}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkSoft}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Classes="faint tnum" Text="{Binding Saved}" VerticalAlignment="Center"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Panel>
            </Border>
            <Expander Background="#0BFFFFFF" BorderBrush="{StaticResource GlassLine}" BorderThickness="1" CornerRadius="10" Header="{Binding OtherSavesLabel}" IsVisible="{Binding HasOtherSaves}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <ItemsControl ItemsSource="{Binding OtherSaves}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SaveRowViewModel">
                    <StackPanel Spacing="3" Margin="0,8">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"/>
                      <TextBlock Classes="faint" Text="{Binding Summary}" TextWrapping="Wrap"/>
                      <TextBlock Classes="faint path" Text="{Binding Where}" ToolTip.Tip="{Binding Where}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ClipToBounds="True">
        <StackPanel Spacing="8">
          <TextBlock Classes="label" Text="{c:T 'BRING SAVES INTO LONGSHOT'}" Margin="0,0,0,2"/>
          <Button Classes="transfer" Command="{Binding ImportCommand}">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
              <c:Icon Kind="download" Width="18" Height="18" VerticalAlignment="Center" Foreground="{StaticResource Brand}"/>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="transferTitle" Text="{c:T 'From an emulator…'}"/>
                <TextBlock Classes="faint" FontSize="11.5" Text="{c:T 'Choose an emulator or a save folder'}" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Button>
          <Button Classes="transfer" Command="{Binding HookshotCommand}">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
              <c:Icon Kind="download" Width="18" Height="18" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="transferTitle" Text="{c:T 'From Hookshot…'}"/>
                <TextBlock Classes="faint" FontSize="11.5" Text="{c:T 'Bring over your Hookshot progress'}"/>
              </StackPanel>
            </Grid>
          </Button>
          <TextBlock Classes="label" Text="{c:T 'TAKE YOUR SAVES WITH YOU'}" Margin="0,10,0,2"/>
          <Button Classes="transfer" Command="{Binding ExportCommand}" ToolTip.Tip="{Binding ExportHint}" ToolTip.ShowOnDisabled="True">
            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
              <c:Icon Kind="upload" Width="18" Height="18" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Classes="transferTitle" Text="{c:T 'Export saves…'}"/>
                <TextBlock Classes="faint" FontSize="11.5" Text="{Binding ExportHint}" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="20">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <c:Icon Kind="check" Width="14" Height="14" Foreground="{StaticResource Go}" VerticalAlignment="Center"/>
        <TextBlock Classes="faint" Text="{c:T 'Existing saves are backed up before every transfer.'}" VerticalAlignment="Center"/>
      </StackPanel>
      <Button Grid.Column="1" Classes="primary" Content="{c:T 'Done'}" Command="{Binding DoneCommand}"/>
    </Grid>
  </Grid>
</UserControl>
