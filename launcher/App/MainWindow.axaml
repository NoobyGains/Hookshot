<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LongshotLauncher.ViewModels"
        xmlns:views="using:LongshotLauncher.Views"
        xmlns:c="using:LongshotLauncher.Controls"
        x:Class="LongshotLauncher.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Longshot"
        Icon="avares://LongshotLauncher/Assets/longshot.png"
        Width="960" Height="600" CanResize="False"
        WindowDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent"
        DragDrop.AllowDrop="True"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <!-- the steps pill (the 2.x Builder's StepPill) -->
    <Style Selector="Border.step">
      <Setter Property="Height" Value="30"/>
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="Padding" Value="4,0,14,0"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="TextElement.FontSize" Value="13"/>
      <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Border.step.now">
      <Setter Property="Background" Value="{StaticResource BrandSoft}"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource BrandInk}"/>
    </Style>
    <Style Selector="Border.step.done">
      <Setter Property="TextElement.Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style Selector="Border.num">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Background" Value="{StaticResource SoftNum}"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="TextElement.FontSize" Value="12"/>
    </Style>
    <Style Selector="Border.num.now">
      <Setter Property="Background" Value="{StaticResource Brand}"/>
      <Setter Property="TextElement.Foreground" Value="White"/>
    </Style>
    <Style Selector="Border.num.done">
      <Setter Property="Background" Value="{StaticResource GoSoft}"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource Go}"/>
    </Style>
    <Style Selector="Border.dialog">
      <Setter Property="Width" Value="440"/>
      <Setter Property="Padding" Value="24"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{StaticResource Raised}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineStrong}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BoxShadow" Value="0 24 60 0 #80000000"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.dialog.wide">
      <Setter Property="Width" Value="580"/>
    </Style>
    <Style Selector="TextBlock.modaltitle">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="Border.dialog TextBlock.sub">
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="StackPanel.buttons">
      <Setter Property="Orientation" Value="Horizontal"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Spacing" Value="10"/>
      <Setter Property="Margin" Value="0,22,0,0"/>
    </Style>
    <Style Selector="TextBlock.channame">
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.chanabout">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{StaticResource InkFaintText}"/>
    </Style>
  </Window.Styles>

  <Border Name="Frame" CornerRadius="18" BorderBrush="{StaticResource GlassLine}" BorderThickness="1" ClipToBounds="True">
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="#1A1D23"/>
        <GradientStop Offset="1" Color="#121418"/>
      </LinearGradientBrush>
    </Border.Background>
    <Panel>
      <Grid RowDefinitions="64,*">
        <!-- the title bar: drag it to move the window -->
        <Grid Name="TitleBar" ColumnDefinitions="*,Auto,*" Background="Transparent">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Image Source="avares://LongshotLauncher/Assets/longshot.png" Width="28" Height="28" RenderOptions.BitmapInterpolationMode="HighQuality"/>
            <TextBlock Text="Longshot" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <Border Grid.Column="1" IsVisible="{Binding InWizard}" Height="40" CornerRadius="20" Padding="4" Background="#0BFFFFFF"
                  BorderBrush="{StaticResource GlassLine}" BorderThickness="1" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Steps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StepItem">
                  <Border Classes="step" Classes.now="{Binding IsNow}" Classes.done="{Binding IsDone}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="num" Classes.now="{Binding IsNow}" Classes.done="{Binding IsDone}" VerticalAlignment="Center">
                        <Panel>
                          <TextBlock Text="{Binding Number}" IsVisible="{Binding !IsDone}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          <c:Icon Kind="check" Width="13" Height="13" IsVisible="{Binding IsDone}"/>
                        </Panel>
                      </Border>
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Classes.linux="{Binding Linux}">
            <Button Classes="caption gear" Command="{Binding SettingsCommand}" IsVisible="{Binding IsHome}" ToolTip.Tip="{c:T 'Settings'}">
              <c:Icon Kind="gear"/>
            </Button>
            <Button Classes="caption" Command="{Binding MinimizeCommand}" ToolTip.Tip="{c:T 'Minimize'}">
              <c:Icon Kind="min"/>
            </Button>
            <Button Classes="caption close" Command="{Binding CloseCommand}" ToolTip.Tip="{c:T 'Close'}">
              <c:Icon Kind="close"/>
            </Button>
          </StackPanel>
        </Grid>

        <TransitioningContentControl Name="Pages" Grid.Row="1" Content="{Binding Page}" Margin="64,16,64,32">
          <TransitioningContentControl.DataTemplates>
            <DataTemplate DataType="vm:HomeViewModel"><views:HomeView/></DataTemplate>
            <DataTemplate DataType="vm:FilesStepViewModel"><views:FilesStepView/></DataTemplate>
            <DataTemplate DataType="vm:SettingsStepViewModel"><views:SettingsStepView/></DataTemplate>
            <DataTemplate DataType="vm:BuildStepViewModel"><views:BuildStepView/></DataTemplate>
            <DataTemplate DataType="vm:ReadyViewModel"><views:ReadyView/></DataTemplate>
            <DataTemplate DataType="vm:ProblemViewModel"><views:ProblemView/></DataTemplate>
            <DataTemplate DataType="vm:ProblemPageViewModel"><views:ProblemPageView/></DataTemplate>
            <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView/></DataTemplate>
            <DataTemplate DataType="vm:SavesViewModel"><views:SavesView/></DataTemplate>
            <DataTemplate DataType="vm:SavesConfirmViewModel"><views:SavesConfirmView/></DataTemplate>
            <DataTemplate DataType="vm:SavesResultViewModel"><views:SavesResultView/></DataTemplate>
          </TransitioningContentControl.DataTemplates>
        </TransitioningContentControl>
      </Grid>

      <!-- a dialog over the window -->
      <Border IsVisible="{Binding HasModal}" Background="#B30A0B0E">
        <ContentControl Content="{Binding Modal}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:ChannelPickerViewModel"><views:ChannelPickerView/></DataTemplate>
            <DataTemplate DataType="vm:DeleteViewModel"><views:DeleteView/></DataTemplate>
            <DataTemplate DataType="vm:LicenceViewModel"><views:LicenceView/></DataTemplate>
            <DataTemplate DataType="vm:StopBuildViewModel"><views:StopBuildView/></DataTemplate>
            <DataTemplate DataType="vm:SavePickViewModel"><views:SavePickView/></DataTemplate>
            <DataTemplate DataType="vm:HookshotImportViewModel"><views:HookshotImportView/></DataTemplate>
            <DataTemplate DataType="vm:HookshotSettingsViewModel"><views:HookshotSettingsView/></DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Border>

      <!-- a file dragged over step 1 -->
      <Border IsVisible="{Binding Dropping}" Margin="10" CornerRadius="14" BorderBrush="{StaticResource Brand}" BorderThickness="2"
              Background="#1F3D63E6" IsHitTestVisible="False">
        <TextBlock Text="{c:T 'Drop your game file to check it'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource BrandInk}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>

      <Border IsVisible="{Binding HasToast}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="16,10"
              CornerRadius="8" Background="{StaticResource Raised}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
              BoxShadow="0 12 30 0 #66000000" IsHitTestVisible="False">
        <TextBlock Text="{Binding Toast}" FontSize="13"/>
      </Border>
    </Panel>
  </Border>
</Window>
