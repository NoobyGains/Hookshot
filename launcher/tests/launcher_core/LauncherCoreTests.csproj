<Project Sdk="Microsoft.NET.Sdk">
  <!-- The launcher's core sources compiled with this fixture (no package, no network): tests/test_launcher_core.py runs it -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <UseSharedCompilation>false</UseSharedCompilation>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>LauncherCoreTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Core/**/*.cs" Exclude="../../Core/obj/**;../../Core/bin/**" LinkBase="Core"/>
    <EmbeddedResource Include="../../Core/Lang/*.json" LogicalName="Lang.%(Filename).json"/>
  </ItemGroup>
</Project>
