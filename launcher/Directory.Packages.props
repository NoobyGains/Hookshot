<Project>
  <!-- The launcher's packages, one version each (exact pins; packages.lock.json records what they bring in) -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="[12.1.6]"/>
    <PackageVersion Include="Avalonia.Desktop" Version="[12.1.6]"/>
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="[12.1.6]"/>
    <PackageVersion Include="Avalonia.Wayland" Version="[12.1.6]"/>
    <!-- (tools/screens only: the window drawn with no screen, for the docs' pictures and CI's check that every page draws) -->
    <PackageVersion Include="Avalonia.Headless" Version="[12.1.6]"/>
  </ItemGroup>
</Project>
